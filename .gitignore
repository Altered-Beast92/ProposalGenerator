# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules/
/.pnp
.pnp.js

# python (renderer service)
.venv/
__pycache__/
*.py[cod]

# testing
/coverage

# next.js
# Unrooted: the app lives at apps/web, so "/.next/" matched nothing and its
# build cache was being committed.
.next/
/out/

# production / rendered output
build/

# scratch output from the fidelity verifier
packages/spec/layouts/__verify_*.json

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*.local
.env

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# build artifact: copied from packages/spec by apps/web/scripts/sync-spec.mjs
apps/web/spec/
